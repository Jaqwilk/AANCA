* text=auto eol=lf

# Markdown uses two trailing spaces for an intentional hard line break. Frozen
# protocol bytes are retained even when they also contain a final blank line.
*.md whitespace=-trailing-space,-blank-at-eof

# These checksum-pinned inputs predate the repository whitespace audit. Preserve
# their exact frozen bytes rather than silently invalidating their SHA-256 sidecars.
configs/nucls_supervised_qc_prospective.yaml whitespace=-blank-at-eof
configs/puma_new_data_confirmation.yaml whitespace=-blank-at-eof
configs/puma_new_data_runtime_amendment.yaml whitespace=-blank-at-eof
configs/puma_realism_stress.yaml whitespace=-blank-at-eof

# Keep binary research and presentation assets byte-for-byte.
*.npy binary
*.npz binary
*.parquet binary
*.png binary
*.zip binary

# Large independently verifiable PUMA evidence stays versioned without bloating
# the ordinary Git object history.
artifacts/puma_audit_time_label_sensitivity/evidence_arrays.npz filter=lfs diff=lfs merge=lfs -text
artifacts/puma_new_data_confirmation/evidence_arrays.npz filter=lfs diff=lfs merge=lfs -text
artifacts/puma_realism_stress/evidence_arrays.npz filter=lfs diff=lfs merge=lfs -text
